# Site URL (Stripe redirects, emails, sitemap) — prod : https://nextfightsstats.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=NextFight

# Emails (Resend) — domaine vérifié sur Resend (ex. nextfightsstats.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@nextfightsstats.com
CONTACT_EMAIL=contact@nextfightsstats.com
CONTACT_TO_EMAIL=contact@nextfightsstats.com
UNSUBSCRIBE_SECRET=une_cle_secrete_longue_et_aleatoire
# Optionnel (sinon réutilise UNSUBSCRIBE_SECRET) — liens de connexion /login
MAGIC_LINK_SECRET=une_autre_cle_longue_et_aleatoire

# Supabase — abonnements Premium (obligatoire en production)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel (/admin) + connexion client en dev local (/login)
ADMIN_SECRET=change-me-to-a-strong-password

# Force la connexion email en production (déconseillé)
# ALLOW_DEV_AUTH=1

# Analyses rédigées (texte uniquement — les probabilités viennent du moteur statistique)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Stripe — subscriptions
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...

# Create products: npm run stripe:setup

# Google Analytics 4 — ID de mesure (Admin → Flux de données). Laisser vide en local.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
