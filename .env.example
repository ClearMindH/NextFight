# Site URL (Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — abonnements Premium (obligatoire en production)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel (/admin) + connexion client en dev local (/login)
ADMIN_SECRET=change-me-to-a-strong-password

# Force la connexion email en production (déconseillé)
# ALLOW_DEV_AUTH=1

# Analyses rédigées (texte uniquement — les probabilités viennent du moteur statistique)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Stripe — subscriptions
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...

# Create products: npm run stripe:setup
